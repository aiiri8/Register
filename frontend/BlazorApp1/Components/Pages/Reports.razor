@page "/Reports"
@attribute [StreamRendering]

<PageTitle>Отчеты</PageTitle>

<h1>Отчеты</h1>

<p>Каталог отчетов</p>

@if (wards == null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Отчет</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var ward in wards!)
        {
            <tr>
                <td><a href="/reports">@ward</a></td>
            </tr>
        }
        </tbody>
    </table>
    
    <button class="btn btn-primary">Добавить отчет за текущий месяц</button>
}

