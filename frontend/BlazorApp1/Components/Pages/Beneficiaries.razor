@page "/beneficiaries"
@attribute [StreamRendering]

<PageTitle>Льготники</PageTitle>

@if (wards == null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Фамилия</th>
            <th>Имя</th>
            <th>Отчество</th>
            <th>Дата рождения</th>
            <th>СНИЛС</th>
            <th>Управление</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var ward in wards!)
        {
            <tr>
                <td>@ward.LastName</td>
                <td>@ward.FirstName</td>
                <td>@ward.Patronymic</td>
                <td>@ward.Birthday.Date.ToShortDateString()</td>
                <td>@ward.Snils</td>
                <td><a href="/">Изменить</a></td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private Ward[]? wards;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        
        var ward4 = new Ward()
        {
            LastName = "Иванова",
            FirstName = "Евгения",
            Patronymic = "Ивановна",
            Birthday = new DateTime(2017, 3, 8),
            Snils = "4"
        };
        
        var ward5 = new Ward()
        {
            LastName = "Иванова",
            FirstName = "Светлана",
            Patronymic = "Ивановна",
            Birthday = new DateTime(2022, 7, 15),
            Snils = "5"
        };
        wards = new []{ward4, ward5};
    }

    private class Ward
    {
        public string? LastName { get; set; }
        public string? FirstName { get; set; }
        public string? Patronymic { get; set; }
        public DateTime Birthday { get; set; }
        public string? Snils { get; set; }
    }
}