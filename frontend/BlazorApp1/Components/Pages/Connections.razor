@page "/Connections"
@attribute [StreamRendering]

@if (wards == null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Фамилия</th>
            <th>Имя</th>
            <th>Отчество</th>
            <th>Дата рождения</th>
            <th>СНИЛС</th>
            <th>Управление</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var ward in wards!)
        {
            <tr>
                <td>@ward.LastName</td>
                <td>@ward.FirstName</td>
                <td>@ward.Patronymic</td>
                <td>@ward.Birthday.Date.ToShortDateString()</td>
                <td>@ward.Snils</td>
                <td><a href="/">Редактировать связь</a></td>
            </tr>
        }
        </tbody>
    </table>
    
    <button class="btn btn-primary">Добавить cвязь</button>
}

@code {
    private Ward[]? wards;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        
        var ward2 = new Ward()
        {
            LastName = "Иванов",
            FirstName = "Олег",
            Patronymic = "Иванович",
            Birthday = new DateTime(2014, 7, 16),
            Snils = "2"
        };
        
        var ward3 = new Ward()
        {
            LastName = "Иванов",
            FirstName = "Сергей",
            Patronymic = "Иванович",
            Birthday = new DateTime(2008, 4, 30),
            Snils = "3"
        };
        
        var ward4 = new Ward()
        {
            LastName = "Иванова",
            FirstName = "Евгения",
            Patronymic = "Ивановна",
            Birthday = new DateTime(2017, 3, 8),
            Snils = "4"
        };
        wards = new []{ward2, ward3, ward4};
    }

    private class Ward
    {
        public string? LastName { get; set; }
        public string? FirstName { get; set; }
        public string? Patronymic { get; set; }
        public DateTime Birthday { get; set; }
        public string? Snils { get; set; }
    }
}