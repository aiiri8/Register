@page "/Dicts"
@attribute [StreamRendering]

<PageTitle>Справочники</PageTitle>

<h1>Справочники</h1>

<p>Каталог справочников</p>

@if (wards == null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Название</th>
            <th>Управление</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var ward in wards!)
        {
            <tr>
                <td>@ward</td>
                <td><a href="/">Редактировать</a></td>
            </tr>
        }
        </tbody>
    </table>
}

